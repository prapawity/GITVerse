{
  "name": "gitverse",
  "productName": "GITVerse",
  "version": "0.1.3",
  "private": true,
  "description": "A desktop Git client with commit graphs, conflict tools, and optional AI assistance.",
  "author": "GITVerse contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/prapawity/GITVerse.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "main": "dist-electron/main/main.js",
  "scripts": {
    "predev": "node scripts/brand-electron.cjs",
    "postinstall": "node scripts/brand-electron.cjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "security:audit": "npm audit --audit-level=high --registry=https://registry.npmjs.org",
    "test": "tsx --test electron/updates.test.ts electron/repositoryScan.test.ts electron/git/history.test.ts electron/git/discard.test.ts electron/git/stash.test.ts src/store/repoStore.test.ts scripts/smoke-electron.test.cjs",
    "test:electron": "npm run build && node scripts/smoke-electron.cjs",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@github/copilot-sdk": "^1.0.28",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "jose": "^6.2.15",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^2.1.0",
    "semver": "^7.8.6",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.7.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "postcss": "^8.4.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.7",
    "vite-plugin-electron": "^0.28.0"
  },
  "overrides": {
    "@github/copilot-sdk": {
      "zod": "$zod"
    },
    "minimatch@>=7 <11.0.1": "^11.0.5"
  }
}
