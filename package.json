{
  "name": "gitverse",
  "productName": "GITVerse",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop Git client with commit graphs, conflict tools, and optional AI assistance.",
  "author": "GITVerse contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/prapawity/GITVerse.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "node scripts/brand-electron.cjs",
    "postinstall": "node scripts/brand-electron.cjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "tsx --test electron/updates.test.ts",
    "dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@github/copilot-sdk": "^1.0.28",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "jose": "^6.2.15",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.0",
    "semver": "^7.7.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/semver": "^7.7.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "tsx": "^4.20.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0"
  }
}
