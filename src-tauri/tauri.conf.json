{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GITVerse",
  "version": "1.0.0",
  "identifier": "io.github.prapawity.gitverse",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GITVerse",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../resources/icon.png", "../resources/icon.icns", "../resources/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/prapawity/GITVerse/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
